# Copy to .env.local for local work. In Vercel, set these under Project > Settings > Environment Variables.

# Launch switch. Leave unset (or false) until borilbogoev.com points at this app:
# the site then tells search engines not to index it. Set to "true" in Production at launch.
SITE_INDEXABLE=false

# Inquiry form storage (Neon Postgres). Added by Vercel > Storage > Neon.
DATABASE_URL=

# Inquiry form email notification (Resend). Optional but recommended.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL="Boril Bogoev Website <inquiries@your-verified-domain>"

# Admin sign-in (/admin). Same variables and password hash format as BB Command Center.
# AUTH_SECRET signs session cookies (32+ characters): node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# While the users table is empty, signing in with AUTH_EMAIL + the password behind AUTH_PASSWORD_HASH creates the first owner.
# Hash a password: node -e "const c=require('crypto');const s=c.randomBytes(16);c.scrypt(process.argv[1],s,64,(e,h)=>console.log('scrypt:'+s.toString('hex')+':'+h.toString('hex')))" "your password"
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
# Optional Google sign-in for users created in Admin > Users, and the production URL used for the redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_URL=

# Forms: file uploads and image blocks (Vercel > Storage > Blob, a private store) and the daily cleanup cron.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
