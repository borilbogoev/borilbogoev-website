# Copy to .env.local for local work. In Vercel, set these under Project > Settings > Environment Variables.

# Launch switch. Leave unset (or false) until borilbogoev.com points at this app:
# the site then tells search engines not to index it. Set to "true" in Production at launch.
SITE_INDEXABLE=false

# Inquiry form storage (Neon Postgres). Added by Vercel > Storage > Neon.
DATABASE_URL=

# Inquiry form email notification (Resend). Optional but recommended.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL="Boril Bogoev Website <inquiries@your-verified-domain>"
